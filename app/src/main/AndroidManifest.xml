<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.hardware.bluetooth" />

    <application
        android:name="com.coreswap.core.CoreSwapApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.CoreSwap">

        <activity
            android:name="com.coreswap.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Headless mode entry points. Names are the MacroDroid contract; keep them stable. -->
        <activity
            android:name="com.coreswap.mode.SetNoiseCancelingActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/activity_anc"
            android:launchMode="singleTop"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CoreSwap.Headless">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="com.coreswap.action.SET_ANC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.coreswap.mode.SetTransparencyActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/activity_transparency"
            android:launchMode="singleTop"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CoreSwap.Headless">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="com.coreswap.action.SET_TRANSPARENCY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.coreswap.mode.SetNormalActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/activity_normal"
            android:launchMode="singleTop"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CoreSwap.Headless">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="com.coreswap.action.SET_NORMAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Placeholder service that only keeps the process warm; see KeepAliveService. -->
        <service
            android:name="com.coreswap.core.KeepAliveService"
            android:exported="true"
            android:label="@string/keep_alive_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
