<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      CoreSwap is dark only. Theme.DeviceDefault follows the system light/dark setting on some
      builds, so the window background is pinned explicitly to stop a white flash on launch.
    -->
    <style name="Theme.CoreSwap" parent="android:Theme.DeviceDefault">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
    </style>

    <!--
      Mode activities are invisible trampolines. Translucent so whatever is on screen stays
      visible, and with no window animation so nothing flickers when one is launched.
    -->
    <style name="Theme.CoreSwap.Headless" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!--
      Mode menu overlay. Translucent so the current screen stays visible under the scrim;
      window animation is Compose-only.
    -->
    <style name="Theme.CoreSwap.Overlay" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
